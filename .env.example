# Copy to .env and fill in the values. .env is git-ignored — never commit it.

# Session signing key. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# Public URL of the app (used in emailed login links)
BASE_URL=http://localhost:8000

# Gmail SMTP app password for sample.logbook@gmail.com
SMTP_PASSWORD=

# Only needed when running without Docker (docker-compose.yml sets these)
DATABASE_URL=postgresql+asyncpg://logbook:logbook@localhost:5432/logbook
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=100

# Days before a team coordinator can answer a proposed entry or access request the owner hasn't answered
# APPROVAL_ESCALATION_DAYS=7
